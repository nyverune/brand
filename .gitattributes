# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.lua text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.kdl text eol=lf
*.svg text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
LICENSE text eol=lf
